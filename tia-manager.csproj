<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>tia_manager</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tia-manager.Blazor/**/*.cs" />
    <Content Remove="tia-manager.Blazor/**/*" />
    <EmbeddedResource Remove="tia-manager.Blazor/**/*" />
    <None Remove="tia-manager.Blazor/**/*" />
    <RazorComponent Remove="tia-manager.Blazor/**/*.razor" />
    <Compile Remove="TechnicalImpact.Api/**/*.cs" />
    <Content Remove="TechnicalImpact.Api/**/*" />
    <EmbeddedResource Remove="TechnicalImpact.Api/**/*" />
    <None Remove="TechnicalImpact.Api/**/*" />
    <RazorComponent Remove="TechnicalImpact.Api/**/*.razor" />
  </ItemGroup>

</Project>
